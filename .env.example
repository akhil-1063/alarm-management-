# Copy this file to .env and adjust values. Never commit .env to version control.

# Secret key used to sign session cookies. Generate a long random value:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
ICU_SECRET_KEY=change-me-to-a-long-random-string

# SQLite database file path (relative to project root or absolute)
ICU_DATABASE_URL=sqlite:///./icu_monitor.db

# Host/port the FastAPI server binds to
ICU_HOST=0.0.0.0
ICU_PORT=8080

# Session lifetime in minutes
ICU_SESSION_MINUTES=480

# Staleness threshold in seconds after which sensor data is considered stale
ICU_STALE_SECONDS=60

# Device offline threshold in seconds
ICU_DEVICE_OFFLINE_SECONDS=120

# Minutes after a resolved alert during which identical alerts are suppressed
ICU_ALERT_COOLDOWN_MINUTES=10

# Minutes a critical alert may stay unacknowledged before re-escalation
ICU_CRITICAL_ESCALATION_MINUTES=15

# How often the background device-health monitor runs, in seconds
ICU_DEVICE_HEALTH_INTERVAL_SECONDS=30

# Login throttle: max failed attempts per username per window
ICU_LOGIN_MAX_ATTEMPTS=5
ICU_LOGIN_WINDOW_SECONDS=300

# Direct ESP8266 /data fetch (server proxies when browser cannot fetch directly)
ICU_ESP_FETCH_ENABLED=true
ICU_ESP_FETCH_TIMEOUT_SECONDS=4.0
ICU_ESP_FETCH_HOST_ALLOWLIST=10.,172.16.,172.17.,172.18.,172.19.,172.20.,172.21.,172.22.,172.23.,172.24.,172.25.,172.26.,172.27.,172.28.,172.29.,172.30.,172.31.,192.168.,169.254.
ICU_ESP_FETCH_ALLOW_LOCALHOST=false

# Simulated BP (potentiometer) thresholds — non-clinical, display only
ICU_BP_SYSTOLIC_HIGH=160.0
ICU_BP_SYSTOLIC_LOW=90.0
ICU_BP_DIASTOLIC_HIGH=100.0
ICU_BP_DIASTOLIC_LOW=60.0

# Set to 1 to enable verbose logging (never log secrets)
ICU_DEBUG=0
